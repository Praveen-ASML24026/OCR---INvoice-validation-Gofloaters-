# GoFloaters Invoice Parser Environment Configuration Template
# Copy to .env and configure your production values
INVOICE_API_KEYS=gf_prod_your_api_key_1,gf_prod_your_api_key_2
AUTH_REQUIRED=true
PORT=8000
HOST=0.0.0.0
TRUST_PROXY=false
TRUSTED_PROXIES=127.0.0.1,::1
INVOICE_MAX_UPLOAD_MB=20
EXECUTION_TIMEOUT_MS=120000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_S=60
